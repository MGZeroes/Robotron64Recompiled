--- a/recompinput/src/input_events.cpp
+++ b/recompinput/src/input_events.cpp
@@ -4,6 +4,13 @@
 #include "recompinput/profiles.h"
 #include "recompui/config.h"
 #include "ultramodern/ultramodern.hpp"
+#if defined(__ANDROID__)
+#include "SDL_syswm.h"
+
+namespace recompui::renderer {
+    void android_set_resume_window(void* native_window);
+}
+#endif
 
 static struct {
     std::list<std::filesystem::path> files_dropped;
@@ -238,6 +245,25 @@ bool sdl_event_filter(void* userdata, SDL_Event* event) {
         // Always queue button up events to avoid missing them during binding.
         recompui::queue_event(*event);
         break;
+#if defined(__ANDROID__)
+    case SDL_APP_WILLENTERBACKGROUND:
+        ultramodern::set_app_paused(true);
+        queue_if_enabled(event);
+        break;
+    case SDL_APP_DIDENTERFOREGROUND: {
+        // The surface was recreated, so RT64 needs the new one. Before unpausing, so the next frame already rebuilds it.
+        // Window 1 is the game's only window.
+        SDL_SysWMinfo wm_info;
+        SDL_VERSION(&wm_info.version);
+        SDL_Window* window = SDL_GetWindowFromID(1);
+        if (window != nullptr && SDL_GetWindowWMInfo(window, &wm_info) && wm_info.info.android.window != nullptr) {
+            recompui::renderer::android_set_resume_window(wm_info.info.android.window);
+        }
+        ultramodern::set_app_paused(false);
+        queue_if_enabled(event);
+        break;
+    }
+#endif
     default:
         queue_if_enabled(event);
         break;
diff --git a/recompui/src/renderer/rt64_render_context.cpp b/recompui/src/renderer/rt64_render_context.cpp
