--- a/recompui/src/renderer/rt64_render_context.cpp
+++ b/recompui/src/renderer/rt64_render_context.cpp
@@ -1,6 +1,8 @@
 #if defined(__ANDROID__)
 #include "SDL.h"
 #include "SDL_syswm.h"
+#include <android/native_window.h>
+#include <atomic>
 #endif
 
 #include <memory>
@@ -26,6 +28,23 @@ static RT64::UserConfiguration::Antialiasing device_max_msaa = RT64::UserConfigu
 static bool sample_positions_supported = false;
 static bool high_precision_fb_enabled = false;
 
+#if defined(__ANDROID__)
+// Holds a reference to the window, which setRenderWindow takes over.
+static std::atomic<ANativeWindow*> pending_resume_window{nullptr};
+
+// Android destroys the surface while the app is in the background. Called on the SDL event thread with the new one; only
+// the graphics thread touches RT64, so it picks the window up in update_screen.
+namespace recompui::renderer {
+    void android_set_resume_window(void* native_window) {
+        ANativeWindow* window = static_cast<ANativeWindow*>(native_window);
+        ANativeWindow_acquire(window);
+        if (ANativeWindow* superseded = pending_resume_window.exchange(window)) {
+            ANativeWindow_release(superseded);
+        }
+    }
+}
+#endif
+
 static uint8_t DMEM[0x1000];
 static uint8_t IMEM[0x1000];
 
@@ -369,6 +388,16 @@ void renderer::RT64Context::send_dummy_workload(uint32_t fb_address) {
 }
 
 void renderer::RT64Context::update_screen() {
+#if defined(__ANDROID__)
+    if (ANativeWindow* window = pending_resume_window.exchange(nullptr)) {
+        if (app->swapChain != nullptr) {
+            app->swapChain->setRenderWindow(window);
+        }
+        else {
+            ANativeWindow_release(window);
+        }
+    }
+#endif
     check_refresh_rate_changes();
     app->updateScreen();
 }
